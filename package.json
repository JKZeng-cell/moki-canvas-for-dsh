{
  "name": "dsh-moki-canvas",
  "version": "1.5.2",
  "license": "MIT",
  "scripts": {
    "build": "npm run build --prefix vendor/moki && node scripts/build.mjs",
    "build:plugin": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:canvas": "npm test --prefix vendor/moki -- tests/dsh-bridge.test.ts tests/dsh-file-preview.test.tsx tests/mindmap-mcp.test.ts tests/window-selection-context.test.ts src/vendor/moki/whiteboard/mind-map.test.ts",
    "typecheck": "npm run typecheck --prefix vendor/moki",
    "guide:generate": "node scripts/create-introduction.mjs"
  },
  "dependencies": {
    "zod": "^4.1.0",
    "sharp": "^0.35.4",
    "unpdf": "^1.8.1",
    "pdfjs-dist": "^6.2.108",
    "@extend-ai/react-pptx": "^0.1.2",
    "dsh-univer-office": "0.2.10"
  },
  "type": "module",
  "description": "MOKI Canvas for DSH — a local-first infinite canvas with mind maps, media, and two-way AI collaboration.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/host.mjs",
    "lib/build-info.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "app",
    "builtin",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "author": "MOKI",
  "homepage": "https://github.com/JKZeng-cell/moki-canvas-for-dsh#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/JKZeng-cell/moki-canvas-for-dsh.git"
  },
  "bugs": {
    "url": "https://github.com/JKZeng-cell/moki-canvas-for-dsh/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "moki",
    "canvas",
    "whiteboard",
    "mind-map",
    "local-first",
    "ai-collaboration"
  ],
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  }
}
